{
  "name": "study-replanner",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "study-planner",
      "database_id": "e0b69f5d-1833-44a1-972a-049ecf5e9038"
    }
  ],
  "triggers": {
    "crons": [
      // هر ۱۲ ساعت یک بازچینی کامل: ۰۰:۰۵ و ۱۲:۰۵ به وقت تهران (۲۰:۳۵ و ۰۸:۳۵ UTC)
      // این رشته باید دقیقاً با FORCED_CRON در index.js یکی باشد
      "35 20,8 * * *",
      // هر ۵ دقیقه چک می‌کند دیتابیس تغییر کرده یا نه؛ فقط اگر تغییر کرده بود بازچینی می‌کند
      "*/5 * * * *"
    ]
  }
}
